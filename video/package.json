{
  "name": "wrunski-video",
  "version": "0.1.0",
  "private": true,
  "description": "O vídeo de apresentação do Wagner, feito em código com o Remotion: a prova da cena 3 (o Tem na Geladeira numa moldura de celular).",
  "license": "UNLICENSED",
  "scripts": {
    "render": "remotion render cena3 out/cena-3.mp4",
